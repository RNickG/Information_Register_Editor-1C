&НаСервере
Процедура ОчиститьРегистрНаСервере()
	
	НаборЗаписей = РегистрыСведений[ИмяРегистраСведений].СоздатьНаборЗаписей();
	НаборЗаписей.ОбменДанными.Загрузка = ОбменДаннымиЗагрузка;
	
	Если ПодчинениеРегистратору Тогда
		
		ВсеРегистраторы = ПолучитьМассивВсехРегистраторов();
		
		Попытка
			
			НачатьТранзакцию();
			
			Для каждого Регистратор Из ВсеРегистраторы Цикл
				
				НаборЗаписей.Очистить();
				НаборЗаписей.Отбор.Регистратор.Значение = Регистратор;
				НаборЗаписей.Записать();
				
			КонецЦикла;
			
		Исключение
			
			ОтменитьТранзакцию();
			Сообщить(ОписаниеОшибки());
			Возврат;
			
		КонецПопытки;
		
		ЗафиксироватьТранзакцию();
		Сообщить("Регистр очищен.");
		
	Иначе
		
		Попытка
			
			НаборЗаписей.Записать();
			Сообщить("Регистр очищен.");
			
		Исключение
			
			Сообщить(ОписаниеОшибки());
			
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьПоОтборуНаСервере()
	
	НаборЗаписей = РегистрыСведений[ИмяРегистраСведений].СоздатьНаборЗаписей();
	НаборЗаписей.ОбменДанными.Загрузка = ОбменДаннымиЗагрузка;
	
	ЗаполнитьОтборНабораЗаписей(НаборЗаписей, "ПоПолямОтбора");
	
	НаборЗаписей.Прочитать();
	
	Если ЕстьОтборСКД() Тогда
		
		ТЗНабора = НаборЗаписей.Выгрузить();
		
		ДобавитьКолонкуУИДСтроки(ТЗНабора);
		
		ТЗПоОтбору = ПолучитьТЗПоОтбору(ТЗНабора, Истина);
		
		УдалитьСтрокиИзТаблицыПоУИД(ТЗНабора, ТЗПоОтбору);
		
		НаборЗаписей.Очистить();
		НаборЗаписей.Загрузить(ТЗНабора);
		
	Иначе
		
		НаборЗаписей.Очистить();
		
	КонецЕсли;
	
	Попытка
		
		НаборЗаписей.Записать();
		Сообщить("Удаление записей по отбору звершено.");
		
	Исключение
		
		Сообщить(ОписаниеОшибки());
		
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьПоОтборуНаСервере()
	
	НаборЗаписей = РегистрыСведений[ИмяРегистраСведений].СоздатьНаборЗаписей();
	НаборЗаписей.ОбменДанными.Загрузка = ОбменДаннымиЗагрузка;
	НовыйНаборЗаписей = Неопределено;
	
	ЗаполнитьОтборНабораЗаписей(НаборЗаписей, "ПоПолямОтбора");
	
	СтруктураИспользуемыхЗначений = ПолучитьСтруктуруИспользуемыхЗначений();
		
	ИзменяютсяСвойствОтбора = Ложь;
	
	Для Каждого ЭлементОтбора из НаборЗаписей.Отбор Цикл
		
		ЗначениеСвойства = Неопределено;
		
		Если СтруктураИспользуемыхЗначений.Свойство(ЭлементОтбора.Имя, ЗначениеСвойства) Тогда
			
			Если не ЭлементОтбора.Значение = ЗначениеСвойства Тогда
				
				ИзменяютсяСвойствОтбора = Истина;
				Прервать;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЕстьОтборСКД = ЕстьОтборСКД();
	
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда
		
		Сообщить("По условиям отбора нет записей для изменения!", СтатусСообщения.Внимание);
		Возврат;
		
	КонецЕсли;
	
	ТЗНабора = НаборЗаписей.Выгрузить();
	
	Если ЕстьОтборСКД Тогда
		
		ДобавитьКолонкуУИДСтроки(ТЗНабора);
					
		ТЗПоОтбору = ПолучитьТЗПоОтбору(ТЗНабора, Истина);
		
		Если ТЗПоОтбору.Количество() = 0 Тогда
			
			Сообщить("По условиям отбора нет записей для изменения!", СтатусСообщения.Внимание);
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// определим таблицу для изменения записей
	
	Если ИзменяютсяСвойствОтбора и ЕстьОтборСКД Тогда
		
		ТаблицаДляОбработки = ТЗПоОтбору;
		УдалитьСтрокиИзТаблицыПоУИД(ТЗНабора, ТЗПоОтбору);
		
	Иначе
		
		ТаблицаДляОбработки = ТЗНабора;
		
	КонецЕсли;
	
	// обработаем записи в таблице
	Для Каждого Запись из ТаблицаДляОбработки Цикл
		
		Если ЕстьОтборСКД и не ИзменяютсяСвойствОтбора Тогда
			
			Если  ТЗПоОтбору.Найти(Запись.__УИД_строки, "__УИД_строки") = Неопределено Тогда
				
				Продолжить;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Запись, СтруктураИспользуемыхЗначений);
		
		Если ИспользоватьПроизвольныйАлгоритм Тогда
			
			Попытка
				
				Выполнить(ПроизвольныйАлгоритм);
				
			Исключение
				
				Сообщить(ОписаниеОшибки());
				Возврат;
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// заполним наборы записей измененными данными
	НаборЗаписей.Очистить();
	
	Если ИзменяютсяСвойствОтбора Тогда
		
		Если ЕстьОтборСКД Тогда
			
			НаборЗаписей.Загрузить(ТЗНабора);
			
		КонецЕсли;
		
		НовыйНаборЗаписей = РегистрыСведений[ИмяРегистраСведений].СоздатьНаборЗаписей();
		НовыйНаборЗаписей.ОбменДанными.Загрузка = ОбменДаннымиЗагрузка;
		ЗаполнитьОтборНабораЗаписей(НовыйНаборЗаписей);
		
		
		НовыйНаборЗаписей.Загрузить(ТаблицаДляОбработки);
	Иначе	
		
		НаборЗаписей.Загрузить(ТаблицаДляОбработки);
		
	КонецЕсли;
	
	Если ЕстьОтборСКД тогда
		
		КоличествоЗаписей = ТЗПоОтбору.Количество();
	Иначе 
		
		КоличествоЗаписей = ТаблицаДляОбработки.Количество();
		
	КонецЕсли;
		
	// заполним дополнительные свойства набора записей
	Если ИспользоватьДополнительныеСвойстваНабораЗаписей Тогда
		
		Для Каждого СтрокаТаблицы из ТаблицаДополнительныеСвойства Цикл
			
			Если СокрЛП(СтрокаТаблицы.КолонкаКлюч) = "" Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			НаборЗаписей.ДополнительныеСвойства.Вставить(СтрокаТаблицы.КолонкаКлюч, СтрокаТаблицы.КолонкаЗначение);
			
			Если не НовыйНаборЗаписей = Неопределено Тогда
				
				НовыйНаборЗаписей.ДополнительныеСвойства.Вставить(СтрокаТаблицы.КолонкаКлюч, СтрокаТаблицы.КолонкаЗначение);
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	// сохраним данные в ИБ
	НачатьТранзакцию();
	
	Попытка
		
		НаборЗаписей.Записать();
		
		Если не НовыйНаборЗаписей = Неопределено Тогда
			
			НовыйНаборЗаписей.Записать(Ложь);
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		Сообщить("Изменение записей по отбору звершено." + Символы.ПС + "Обработано " + КоличествоЗаписей +" записей.");
		
	Исключение
		
		ОтменитьТранзакцию();
		Сообщить(ОписаниеОшибки());
		
	КонецПопытки;
	
КонецПроцедуры


