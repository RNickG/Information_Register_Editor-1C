&НаСервере

Перем СтруктураРеквизитов, МассивРеквизитовРС, МассивЭлементовФормыРС;

&НаСервере
Функция КНС()
	
	Результат = Новый Структура;
	
	Результат.Вставить("ИмяЭлементаСписокЗаписейРС","ЭлементСписокРС");
	Результат.Вставить("ИмяРеквизитаСписокЗаписейРС","ДинамическийСписокРС");
	Результат.Вставить("ИмяРеквизитаТаблицаСпецРеквизитовРС","__ТаблицаСпецРеквизитовРС");
	Результат.Вставить("ИмяЭлементаТаблицаСпецРеквизитовРС","__ЭлементТаблицаСпецРеквизитовРС");

	
	Результат.Вставить("ПрефиксИмениРеквизита","__РеквизитРС_"); 
	Результат.Вставить("ПрефиксИмениРеквизитаИспользование","__РеквизитИспользование_");
	Результат.Вставить("ПрефиксИмениЭлемента","__Элемент_"); 
	Результат.Вставить("ПрефиксИмениЭлементаСписка","__ЭлементСписка_"); 
	Результат.Вставить("ПрефиксИмениГруппыЭлементов","__Группа_"); 
	
	
	Результат.Вставить("ПрефиксИмениЭлементаОтбора","__ЭлементОтбора_");
	Результат.Вставить("ПрефиксИмениРеквизитаОтбора","__РеквизитОтбора_");
	Результат.Вставить("ПрефиксИмениРеквизитаОтбораИспользование","__РеквизитОтбораИспользование_");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция КНК()
	
	Результат = Новый Структура;
	
	Результат.Вставить("ИмяЭлементаСписокЗаписейРС","ЭлементСписокРС");
	Результат.Вставить("ИмяРеквизитаТаблицаСпецРеквизитовРС","__ТаблицаСпецРеквизитовРС");
	Результат.Вставить("ИмяЭлементаТаблицаСпецРеквизитовРС","__ЭлементТаблицаСпецРеквизитовРС");
 	
	Результат.Вставить("ПрефиксИмениРеквизитаИспользование","__РеквизитИспользование_");
	
	Результат.Вставить("ПрефиксИмениЭлементаОтбора","__ЭлементОтбора_");
	Результат.Вставить("ПрефиксИмениРеквизитаОтбора","__РеквизитОтбора_");
	Результат.Вставить("ПрефиксИмениРеквизитаОтбораИспользование","__РеквизитОтбораИспользование_");
	
	
 	Возврат Результат;
	
КонецФункции

#Область Обработчики_Событий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Для Каждого РС из Метаданные.РегистрыСведений Цикл
		Элементы.ИмяРС.СписокВыбора.Добавить(РС.Имя, РС.Синоним + " ("+РС.Имя+")" );
	КонецЦикла;
	
	ДобавляемыеРеквизиты = Новый Массив;
	НовыйРеквизит = Новый РеквизитФормы(КНС().ИмяРеквизитаСписокЗаписейРС, Новый ОписаниеТипов("ДинамическийСписок"));
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	 ЭлементСписокРС = Элементы.Вставить(КНС().ИмяЭлементаСписокЗаписейРС, Тип("ТаблицаФормы"),Элементы["ГруппаСписки"]);
	//ЭлементСписокРС.ВариантУправленияВысотой = ВариантУправленияВысотойТаблицы.ПоСодержимому;
	ЭлементСписокРС.РастягиватьПоВертикали = ложь;
	ЭлементСписокРС.ПутьКДанным = КНС().ИмяРеквизитаСписокЗаписейРС;
	ЭлементСписокРС.УстановитьДействие("ПриАктивизацииСтроки", "СписокРСПриАктивизацииСтроки");
 	
	ГруппаКнопок = Элементы.Добавить("ГруппаВыгрузитьВXML",Тип("ГруппаФормы"),ЭлементСписокРС.КоманднаяПанель);
 	ГруппаКнопок.Заголовок = "Выгрузка / Загрузка XML";
	ЭлементКнопка = Элементы.Добавить("КомандаВыгрузитьВXML",Тип("КнопкаФормы"),ГруппаКнопок);
	ЭлементКнопка.ИмяКоманды = "ВыгрузитьВXML";
	ЭлементКнопка = Элементы.Добавить("КомандаВыгрузитьВXMLПоОтбору",Тип("КнопкаФормы"),ГруппаКнопок);
	ЭлементКнопка.ИмяКоманды = "ВыгрузитьВXMLПоОтбору";
	
	ЭлементКнопка = Элементы.Добавить("КомандаВыгрузитьЗагрузитьИзXML",Тип("КнопкаФормы"),ГруппаКнопок);
	ЭлементКнопка.ИмяКоманды = "ЗагрузитьИзXML";

	ЭлементКнопка = Элементы.Добавить("КомандаОтчетПоДаннымРегистра",Тип("КнопкаФормы"),ЭлементСписокРС.КоманднаяПанель);
 	ЭлементКнопка.ИмяКоманды = "ОтчетПоДаннымРегистра";

	
	
	АдресХранилищаРеквизитовФормы = ПоместитьВоВременноеХранилище(Новый Массив, ЭтаФорма.УникальныйИдентификатор);
	АдресХранилищаЭлементовРеквизитовФормы = ПоместитьВоВременноеХранилище(Новый Массив, ЭтаФорма.УникальныйИдентификатор);
	
	//ИмяОбработки = РеквизитФормыВЗначение("Объект").Метаданные().ПолноеИмя(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	
КонецПроцедуры

&НаСервере
Процедура ИмяРСПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(ИмяРегистраСведений) Тогда
		
		ИницализироватьРеквизитыЭлементыФормы();
		ИнициализироватьСКД();
		
	КонецЕсли;
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяРСПриИзменении(Элемент)
	
	ИмяРСПриИзмененииНаСервере();

	ПЭл = Элементы[КНК().ИмяЭлементаСписокЗаписейРС].КоманднаяПанель.ПодчиненныеЭлементы;
	
	Элементы[КНК().ИмяЭлементаСписокЗаписейРС].ОтображениеСтрокиПоиска.Видимость = Ложь;
	
	Кн = ПЭл.Найти(КНК().ИмяЭлементаСписокЗаписейРС + "Найти");
	Если не Кн = Неопределено Тогда
		Кн.Видимость = Ложь;
	КонецЕсли;
	Кн = ПЭл.Найти(КНК().ИмяЭлементаСписокЗаписейРС + "ОтменитьПоиск");
	Если не Кн = Неопределено Тогда
		Кн.Видимость = Ложь;
	КонецЕсли;
	Кн = ПЭл.Найти(КНК().ИмяЭлементаСписокЗаписейРС + "ПоискПоТекущемуЗначению");
	Если не Кн = Неопределено Тогда
		Кн.Видимость = Ложь;
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяРСАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДанныеВыбора = Новый СписокЗначений;
	
	Для каждого Эл из Элементы.ИмяРС.СписокВыбора Цикл

		Если СтрНайти(НРег(Эл.Представление), Нрег(Текст)) > 0 Тогда
			
			ДанныеВыбора.Добавить(Эл.Значение, Эл.Представление);
			
		КонецЕсли
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитПриИзменении(Элемент)
	
	РеквизитПриИзмененииНаСервере(Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитУИДНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	УИДНажатие(Элемент,"Свойство");
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитОтбораНабораЗаписейПриИзменении(Элемент)
	
	Если Лев(Элемент.Имя, 16) = КНК().ПрефиксИмениЭлементаОтбора Тогда
		
		ЭтаФорма[КНК().ПрефиксИмениРеквизитаОтбораИспользование + Элемент.Заголовок] = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитОтбораНабораЗаписейУИДНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	УИДНажатие(Элемент,"Отбор");
 	
КонецПроцедуры

&НаКлиенте
Процедура УИДНажатие(Элемент,ВидПоля)

	Реквизит = Неопределено;
	ДополнительныеПараметры = Новый Структура;
	
	СтруктураРеквизитов = ПолучитьИзВременногоХранилища(АдресХранилищаСтруктураРеквизитов);
	Если ВидПоля = "Отбор" Тогда
		СтруктураРеквизитов.ЭлементыОтбора.Свойство(Элемент.Имя, Реквизит);
	ИначеЕсли ВидПоля = "Свойство" Тогда
		СтруктураРеквизитов.ЭлементыПоляВвода.Свойство(Элемент.Имя, Реквизит);
	КонецЕсли;
	
	Если не Реквизит = Неопределено Тогда
		СтрокаУИД = ЭтаФорма[Реквизит];
		ДополнительныеПараметры.Вставить("Реквизит", Реквизит);
		ДополнительныеПараметры.Вставить("Элемент", Элемент);
		ДополнительныеПараметры.Вставить("ВидПоля", ВидПоля);
	КонецЕсли;
	
	ПоказатьВводСтроки(Новый ОписаниеОповещения("ВводСтрокиУИДЗавершение", ЭтаФорма, ДополнительныеПараметры), СтрокаУИД, "Введите УИД", 36, Ложь);	

КонецПроцедуры

&НаКлиенте
Процедура ВводСтрокиУИДЗавершение(Строка, ДополнительныеПараметры) Экспорт
	
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Реквизит = ДополнительныеПараметры.Реквизит;
	
	Попытка
		НовыйУИД = Новый УникальныйИдентификатор(Строка);
		
		ЭтаФорма[Реквизит] = НовыйУИД;
		Если ДополнительныеПараметры.ВидПоля = "Свойство" Тогда
			РеквизитПриИзменении(ДополнительныеПараметры.Элемент);
		ИначеЕсли ДополнительныеПараметры.ВидПоля = "Отбор" Тогда
			РеквизитОтбораНабораЗаписейПриИзменении(ДополнительныеПараметры.Элемент)
		КонецЕсли;
	Исключение
		ЭтаФорма[Реквизит] = Неопределено;
		Возврат;
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если не ЗавершениеРаботы = Неопределено Тогда 
		Если ЗавершениеРаботы Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если не ЭтаФорма.ЗакрытьФорму Тогда
	
		Отказ = Истина;
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗакрытьФормуЗавершение", ЭтаФорма), "Закрыть Редактор регистров сведений?", РежимДиалогаВопрос.ДаНет, 5, КодВозвратаДиалога.Да,, КодВозвратаДиалога.Да);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФормуЗавершение(Ответ, Отказ = Истина) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да или Ответ = КодВозвратаДиалога.Таймаут Тогда
		
		ЭтаФорма.ЗакрытьФорму = Истина;
		Отказ = Ложь;
		ЭтаФорма.Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСпецРеквизитовРСВыбор(Элемент, НомерСтроки, Поле, СтандартнаяОбработка)
	
	СтруктураРеквизитов = ПолучитьИзВременногоХранилища(АдресХранилищаСтруктураРеквизитов);
	
	Если не СтруктураРеквизитов.РеквизитыХранилищаЗначения.Найти(Поле.Имя) = Неопределено Тогда
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("НомерСтроки", НомерСтроки);
		ДопПараметры.Вставить("Поле", Поле);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("КлючЗаписи", Элемент.ТекущиеДанные.__КлючЗаписи);
		ПараметрыФормы.Вставить("ИмяРеквизита", Поле.Имя);
		ПараметрыФормы.Вставить("ИмяРегистраСведений", ИмяРегистраСведений);
		ПараметрыФормы.Вставить("ПодчинениеРегистратору", ПодчинениеРегистратору);
		ОткрытьФорму("ВнешняяОбработка.РедактроРегистровСведений.Форма.ФормаЗначениеХранилища"
			,ПараметрыФормы
			,ЭтаФорма,,,
			,Новый ОписаниеОповещения("ФормаЗначениеХранилищаЗакрытие", ЭтаФорма,ДопПараметры)
			,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаЗначениеХранилищаЗакрытие(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия.ДанныеИзменены Тогда
		
		ДанныеСтроки = Элементы[КНК().ИмяЭлементаТаблицаСпецРеквизитовРС].ДанныеСтроки(ДополнительныеПараметры.НомерСтроки);
		ДанныеСтроки[ДополнительныеПараметры.Поле.Имя] = РезультатЗакрытия.ТипЗначенияВХранилищеСтрока;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьДополнительныеСвойстваНабораЗаписейПриИзменении(Элемент)
	
	Элементы.ГруппаДополнительныеСведения.Видимость = ИспользоватьДополнительныеСвойстваНабораЗаписей;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокРСПриАктивизацииСтроки(Элемент)
	
	Если ЕстьСпецРеквизиты Тогда
		
		ЭтаФорма[КНК().ИмяРеквизитаТаблицаСпецРеквизитовРС].Очистить();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область Обработчики_Команд

&НаКлиенте
Процедура ПоказатьРезультатОтбора(Команда)
	
	ТабДок = ПоказатьРезультатОтбораНаСервере();
	ТабДок.Показать("Результат отбора");
	
КонецПроцедуры

&НаСервере
Функция ПоказатьРезультатОтбораНаСервере()
	
	НаборЗаписей = РегистрыСведений[ИмяРегистраСведений].СоздатьНаборЗаписей();
	
	ЗаполнитьОтборНабораЗаписей(НаборЗаписей, "ПоПолямОтбора");
	
	НаборЗаписей.Прочитать();
	
	ТабДанныхПоОтбору = НаборЗаписей.Выгрузить();
	
	Если ЕстьОтборСКД() Тогда
		ТабРезультат = ПолучитьТЗПоОтбору(ТабДанныхПоОтбору);
	Иначе
		ТабРезультат = ТабДанныхПоОтбору;
	КонецЕсли;
	      	
	Построитель = Новый ПостроительОтчета;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабРезультат);
	Построитель.ЗаполнитьНастройки();
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.ОтображатьЗаголовки = Ложь;
	Построитель.Вывести(ТабДок);
	Возврат ТабДок;
	
КонецФункции

&НаКлиенте
Процедура УстановитьОтборСписка(Команда)
	Элементы.УстановитьОтборСписка.Пометка = не Элементы.УстановитьОтборСписка.Пометка;
	УстановитьОтборСпискаНаСервере(Элементы.УстановитьОтборСписка.Пометка);
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборСпискаНаСервере(УстановитьОтбор)
	
	ОтборСпискаЗаписейРС = ЭтаФорма[КНС().ИмяРеквизитаСписокЗаписейРС].Отбор;
	ЗаполнитьОтборДинамическогоСписка(ОтборСпискаЗаписейРС, УстановитьОтбор);

КонецПроцедуры


&НаКлиенте
Процедура ВыполнитьОбработку(Команда)
	
	Если ВидОбработки = "Очистить" Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ОчиститьЗавершение", ЭтаФорма)
			,"Удалить ВСЕ записи регистра?"
			,РежимДиалогаВопрос.ОКОтмена
			,10
			,КодВозвратаДиалога.Отмена
			,
			,КодВозвратаДиалога.Отмена);
	ИначеЕсли ВидОбработки = "УдалитьПоОтбору" Тогда
		
		Если ПодчинениеРегистратору Тогда
			ЗначениеРегистратора = ЭтаФорма[КНК().ПрефиксИмениРеквизитаОтбора + "Регистратор"];
			Если Не ЗначениеЗаполнено(ЗначениеРегистратора) Тогда
				Сообщить("Необходимо указать Регистратор в полях отбора!", СтатусСообщения.Важное);
				Возврат;
			КонецЕсли;
		КонецЕсли;

		ПоказатьВопрос(Новый ОписаниеОповещения("УдалитьПоОтборуЗавершение", ЭтаФорма)
			,"Удалить записи регистра по условиям отбора?"
			,РежимДиалогаВопрос.ОКОтмена
			,10
			,КодВозвратаДиалога.Отмена
			,
			,КодВозвратаДиалога.Отмена);
		
	ИначеЕсли ВидОбработки = "ИзменитьПоОтбору" Тогда
		
		Если ПодчинениеРегистратору Тогда
			ЗначениеРегистратора = ЭтаФорма[КНК().ПрефиксИмениРеквизитаОтбора + "Регистратор"];
			Если Не ЗначениеЗаполнено(ЗначениеРегистратора) Тогда
				Сообщить("Необходимо указать Регистратор в полях отбора!", СтатусСообщения.Важное);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ИзменитьПоОтборуЗавершение", ЭтаФорма)
			,"Изменнть записи регистра по условиям отбора?"
			,РежимДиалогаВопрос.ОКОтмена
			,10
			,КодВозвратаДиалога.Отмена
			,
			,КодВозвратаДиалога.Отмена);
		
	//ИначеЕсли ВидОбработки = "ИзменитьВыбранные" Тогда
	//	
	//	Если Элементы["ЭлементСписокРС"].ВыделенныеСтроки.Количество() = 0 Тогда
	//		Возврат;
	//	КонецЕсли;
	//	
	//	ПоказатьВопрос(Новый ОписаниеОповещения("ИзменитьВыбранныеЗавершение", ЭтаФорма), "Изменить выбранные записи регистра?", РежимДиалогаВопрос.ОКОтмена, 10,КодВозвратаДиалога.Отмена,,КодВозвратаДиалога.Отмена);
	//	
	ИначеЕсли ВидОбработки = "СоздатьЗапись" Тогда
	
		Если ПодчинениеРегистратору Тогда
			Если ЭтаФорма[КНК().ПрефиксИмениРеквизитаИспользование + "Регистратор"] Тогда
				ЗначениеРегистратора = ЭтаФорма[КНС().ПрефиксИмениРеквизита + "Регистратор"];
			Иначе
				ЗначениеРегистратора = ЭтаФорма[КНК().ПрефиксИмениРеквизитаОтбора + "Регистратор"];
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ЗначениеРегистратора) Тогда
				Сообщить("Необходимо указать Регистратор в полях отбора либо в стандартных реквизитах!", СтатусСообщения.Важное);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если Периодический Тогда
			Если не ЗначениеЗаполнено(ЭтаФорма[КНС().ПрефиксИмениРеквизита + "Период"]) или не ЭтаФорма[КНК().ПрефиксИмениРеквизитаИспользование + "Период"] Тогда
				Сообщить("Необходимо указать Период в стандартных реквизитах и включить его использование!", СтатусСообщения.Важное);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		СоздатьЗаписьНаСервере();
		Элементы[КНК().ИмяЭлементаСписокЗаписейРС].Обновить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьВсеВключить(Команда)
	
	УстановитьИспользование("РеквизитыВПоляхВводаИспользование", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьВсеВыключить(Команда)
	
	УстановитьИспользование("РеквизитыВПоляхВводаИспользование", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьВсеОтборВключить(Команда)
	
	УстановитьИспользование("РеквизитыОтбораИспользование", Истина);
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьВсеОтборВыключить(Команда)
	
	УстановитьИспользование("РеквизитыОтбораИспользование", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьИспользование(Реквизиты, Исользование)
	
	СтруктураРеквизитов = ПолучитьИзВременногоХранилища(АдресХранилищаСтруктураРеквизитов);
	
	Для Каждого ИмяРеквизита из СтруктураРеквизитов[Реквизиты] Цикл
		
		ЭтаФорма[ИмяРеквизита.Значение] = Исользование;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоТекущейСтроке(Команда)
	
	Если Элементы[КНК().ИмяЭлементаСписокЗаписейРС].ТекущиеДанные = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СтруктураРеквизитов = ПолучитьИзВременногоХранилища(АдресХранилищаСтруктураРеквизитов);
	
	Для каждого КлючИЗначение из СтруктураРеквизитов.РеквизитыВСписке Цикл
		ЗначениеСвойства = Неопределено;
		Если СтруктураРеквизитов.РеквизитыВПоляхВвода.Свойство(КлючИЗначение.Ключ, ЗначениеСвойства) Тогда
			ЭтаФорма[КлючИЗначение.Значение] = Элементы[КНК().ИмяЭлементаСписокЗаписейРС].ТекущиеДанные[КлючИЗначение.Ключ];
		КонецЕсли;
	КонецЦикла;
	
	Для каждого КлючИзначение из СтруктураРеквизитов.РеквизитыПароли Цикл
		ЭтаФорма[КлючИЗначение.Значение] = Неопределено;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборЗаполнитьПоТекущейСтроке(Команда)
	
	Если Элементы[КНК().ИмяЭлементаСписокЗаписейРС].ТекущиеДанные = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СтруктураРеквизитов = ПолучитьИзВременногоХранилища(АдресХранилищаСтруктураРеквизитов);
	
	Для каждого КлючИЗначение из СтруктураРеквизитов.РеквизитыОтбора Цикл
		
		ЗначениеСвойства = Неопределено;
		
		Если не Элементы[КНК().ИмяЭлементаСписокЗаписейРС].ТекущиеДанные.Свойство(КлючИЗначение.Ключ, ЗначениеСвойства) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ЭтаФорма[КлючИЗначение.Значение] = Элементы[КНК().ИмяЭлементаСписокЗаписейРС].ТекущиеДанные[КлючИЗначение.Ключ];
		ЭтаФорма[СтруктураРеквизитов.РеквизитыОтбораИспользование[КлючИЗначение.Ключ]] = Истина;
		
	КонецЦикла;
	
	ОтборСКД = КомпоновщикНастроек.Настройки.Отбор;
	
	Для каждого КлючевоеПоле Из СтруктураРеквизитов.КлючевыеПоляВнеОтбора Цикл
		
		ПолеКомпоновки = Новый ПолеКомпоновкиДанных(КлючевоеПоле);
		
		Для каждого ЭлементОтбора Из ОтборСКД.Элементы Цикл
			
			Если ЭлементОтбора.ЛевоеЗначение = ПолеКомпоновки Тогда
				
				ЭлементОтбора.ПравоеЗначение = Элементы[КНК().ИмяЭлементаСписокЗаписейРС].ТекущиеДанные[КлючевоеПоле];
				//ЭлементОтбора.Использование = Истина;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЗавершение(Ответ, Параметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ОчиститьРегистрНаСервере();
	
	Элементы[КНК().ИмяЭлементаСписокЗаписейРС].Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПоОтборуЗавершение(Ответ, Параметры) Экспорт
	
