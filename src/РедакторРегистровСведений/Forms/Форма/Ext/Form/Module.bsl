		Возврат;
	КонецЕсли;
	
	УдалитьПоОтборуНаСервере();
	
	Элементы[КНК().ИмяЭлементаСписокЗаписейРС].Обновить();	
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПоОтборуЗавершение(Ответ, Параметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	ИзменитьПоОтборуНаСервере();
	
	Элементы[КНК().ИмяЭлементаСписокЗаписейРС].Обновить();	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВXML(Команда)
	
	ПоказатьДиалогXML(Новый ОписаниеОповещения("ВыборФайлаВыгрузитьXMLЗавершение", ЭтотОбъект, Ложь), РежимДиалогаВыбораФайла.Сохранение);

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВXMLПоОтбору(Команда)
	
	ПоказатьДиалогXML(Новый ОписаниеОповещения("ВыборФайлаВыгрузитьXMLЗавершение", ЭтотОбъект, Истина), РежимДиалогаВыбораФайла.Сохранение);

КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаВыгрузитьXMLЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда 
		
		Возврат;
	КонецЕсли;
	
	РезультатВыгрузки = ВыгрузитьВXMLНаСервере(ДополнительныеПараметры);
	
	Если не РезультатВыгрузки = Неопределено Тогда
		
		Попытка 
			
			ДД = ПолучитьИзВременногоХранилища(РезультатВыгрузки.АдресХранилища);
			ДД.Записать(ВыбранныеФайлы[0]);
			
			Сообщить("Выгрузка в XML завершена, обработано " + РезультатВыгрузки.КоличествоЗаписей + " записей." + Символы.ПС +  "Записан файл: "+ВыбранныеФайлы[0]);
			
		Исключение
			
			Сообщить(ОписаниеОшибки());
			
		КонецПопытки;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзXML(Команда)
	
	ПоказатьДиалогXML(Новый ОписаниеОповещения("ВыборФайлаЗагрузитьXMLЗавершение", ЭтотОбъект), РежимДиалогаВыбораФайла.Открытие);

КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаЗагрузитьXMLЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда 
		
		Возврат;
		
	КонецЕсли;
	
	ДД = Новый ДвоичныеДанные(ВыбранныеФайлы[0]);
	АдресВХранилище = ПоместитьВоВременноеХранилище(ДД);
	ЗагрузитьИзXMLНаСервере(АдресВХранилище);
	
	Элементы[КНК().ИмяЭлементаСписокЗаписейРС].Обновить();	
	
КонецПроцедуры

&НаКлиенте
Процедура ОтчетПоДаннымРегистра(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИмяРегистраСведений", ИмяРегистраСведений);
	ПараметрыФормы.Вставить("ПодчинениеРегистратору", ПодчинениеРегистратору);
	ПараметрыФормы.Вставить("Периодический", Периодический);
	
	ОткрытьФорму("ВнешняяОбработка.РедактроРегистровСведений.Форма.ФормаОтчетПоДанным",ПараметрыФормы ,ЭтаФорма,,,,, РежимОткрытияОкнаФормы.Независимый);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьВыбранныеЗаписи(Команда)
	
	ПоказатьВопрос(Новый ОписаниеОповещения("УдалитьВыбранныеЗавершение", ЭтаФорма), "Удалить выбранные записи регистра?", РежимДиалогаВопрос.ОКОтмена, 10,КодВозвратаДиалога.Отмена,,КодВозвратаДиалога.Отмена);	

КонецПроцедуры

&НаКлиенте
Процедура УдалитьВыбранныеЗавершение(Ответ, Параметры) Экспорт
	
	ВыделенныеСтроки = Элементы[КНК().ИмяЭлементаСписокЗаписейРС].ВыделенныеСтроки;
	
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	Для Каждого ВыдСтрока из ВыделенныеСтроки Цикл
		МассивСтрок.Добавить(Элементы[КНК().ИмяЭлементаСписокЗаписейРС].ДанныеСтроки(ВыдСтрока));
	КонецЦикла;	
	
	УдалитьВыбранныеНаСервере(МассивСтрок);
	
	Элементы[КНК().ИмяЭлементаСписокЗаписейРС].Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗапись(Команда)
	
	КлючЗаписи  = Новый("РегистрСведенийКлючЗаписи."+ИмяРегистраСведений);
	
	ПараметрыФормыЗаписи = Новый Структура("Ключ", КлючЗаписи);
	ОткрытьФорму("РегистрСведений."+ИмяРегистраСведений+".ФормаЗаписи", ПараметрыФормыЗаписи);

КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьСпецРеквизиты(Команда)
	
	ВыделенныеСтроки = Элементы[КНК().ИмяЭлементаСписокЗаписейРС].ВыделенныеСтроки;
	
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ЭтаФорма[КНК().ИмяРеквизитаТаблицаСпецРеквизитовРС].Очистить();
	
	Для каждого ВыделеннаяСтрока Из Элементы[КНК().ИмяЭлементаСписокЗаписейРС].ВыделенныеСтроки Цикл
		
		Если ПодчинениеРегистратору Тогда
			Регистратор = Элементы[КНК().ИмяЭлементаСписокЗаписейРС].ДанныеСтроки(ВыделеннаяСтрока).Регистратор;
		Иначе 
			Регистратор = Неопределено;
		КонецЕсли;
		
		ПрочитатьСпецРеквизитыНаСервере(ВыделеннаяСтрока, Регистратор);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьСпецРеквизитыНаСервере(ВыделеннаяСтрока, Регистратор)
	
	СтруктураРеквизитов = ПолучитьИзВременногоХранилища(АдресХранилищаСтруктураРеквизитов);
		
	КлючЗаписи = Новый Структура;
	Для каждого КлючевоеПоле Из СтруктураРеквизитов.ИменаКлючевыхПолей Цикл
		КлючЗаписи.Вставить(КлючевоеПоле, ВыделеннаяСтрока[КлючевоеПоле]);
	КонецЦикла;
	
	Если ПодчинениеРегистратору Тогда
		КлючЗаписи.Регистратор = Регистратор;
	КонецЕсли;
	
	СтрокаТаблицы = ЭтаФорма[КНС().ИмяРеквизитаТаблицаСпецРеквизитовРС].Добавить();
	ПрочитатьЗначенияСпецРеквизитовВСтроку(СтрокаТаблицы, КлючЗаписи)
	
КонецПроцедуры

#КонецОбласти


#Область Процедуры_Обработки_Данных

&НаСервере
Процедура УдалитьВыбранныеНаСервере(МассивСтрок)
	
	ЕстьОшибки = Ложь; 	
	ОбработаноЗаписей = 0;
	
	НаборЗаписей = РегистрыСведений[ИмяРегистраСведений].СоздатьНаборЗаписей();
	НаборЗаписей.ОбменДанными.Загрузка = ОбменДаннымиЗагрузка;
	
	Для Каждого ВыбраннаяСтрока из МассивСтрок Цикл
		
		Для Каждого ЭлементОтбора из НаборЗаписей.Отбор Цикл 
			
			ЭлементОтбора.Значение = ВыбраннаяСтрока[ЭлементОтбора.Имя];
			ЭлементОтбора.Использование = Истина;
			
		КонецЦикла;
		
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		
		Попытка
			
			НаборЗаписей.Записать();
			ОбработаноЗаписей = ОбработаноЗаписей + 1;
			
		Исключение
			
			Сообщить(ОписаниеОшибки());
			ЕстьОшибки = Истина;
			
		КонецПопытки;
		
	КонецЦикла;
	
	Если не ЕстьОшибки Тогда
		
		Сообщить("Удаление выделенных записей успешно завершено.", СтатусСообщения.Информация);
		
	Иначе
		
		Сообщить("Удаление выделенных записей завершено с ошибками.", СтатусСообщения.Важное);
		
	КонецЕсли;
	
	Сообщить("Обработано " + ОбработаноЗаписей + " записей.");

КонецПроцедуры

