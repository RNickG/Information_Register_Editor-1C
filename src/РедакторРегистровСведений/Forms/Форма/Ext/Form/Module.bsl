&НаСервере
//Заполняет поля отбора набора записей РС
//Вариант заплонения - "Автоматически": поля отбора заполняются по правилу - 
//если в разделе "Свойства" указано использование у свойства, входящего в отбор (измерения), то значение отбора берется из раздела "Свойства"
//иначе из раздела "Отбор"
//	
//Вариант заполнения "ПоПолямОтбора": поля отбора заполняются по значениям из раздела "Отбор"
Процедура ЗаполнитьОтборНабораЗаписей(НаборЗаписей, ВариантЗаполнения = "Автоматически")
	
	Для Каждого ЭлементОтбора из НаборЗаписей.Отбор Цикл
		
		Если ЭлементОтбора.Имя = "Регистратор" Тогда
			
			Если ВариантЗаполнения = "Автоматически" Тогда
				
				Если ЭтаФорма[КНС().ПрефиксИмениРеквизитаИспользование + ЭлементОтбора.Имя] Тогда
					
					ЭлементОтбора.Значение = ЭтаФорма[КНС().ПрефиксИмениРеквизита + ЭлементОтбора.Имя];
					
				Иначе
					
					ЭлементОтбора.Значение = ЭтаФорма[КНС().ПрефиксИмениРеквизитаОтбора + ЭлементОтбора.Имя];
					
				КонецЕсли;
				
			ИначеЕсли ВариантЗаполнения = "ПоПолямОтбора" Тогда
				
				ЭлементОтбора.Значение = ЭтаФорма[КНС().ПрефиксИмениРеквизитаОтбора + ЭлементОтбора.Имя];
				
			КонецЕсли;
		Иначе
			
			Если ВариантЗаполнения = "Автоматически"  Тогда
				
				Если ЭтаФорма[КНС().ПрефиксИмениРеквизитаИспользование + ЭлементОтбора.Имя] Тогда
					
					ЭлементОтбора.Значение = ЭтаФорма[КНС().ПрефиксИмениРеквизита + ЭлементОтбора.Имя];
					ЭлементОтбора.Использование = Истина;
					
				ИначеЕсли ЭтаФорма[КНС().ПрефиксИмениРеквизитаОтбораИспользование + ЭлементОтбора.Имя] Тогда
					
					ЭлементОтбора.Значение = ЭтаФорма[КНС().ПрефиксИмениРеквизитаОтбора + ЭлементОтбора.Имя];
					ЭлементОтбора.Использование = Истина;
					
				Иначе
					
					ЭлементОтбора.Использование = Ложь;
					
				КонецЕсли;
				
			ИначеЕсли ВариантЗаполнения = "ПоПолямОтбора"  Тогда
				
				Если ЭтаФорма[КНС().ПрефиксИмениРеквизитаОтбораИспользование + ЭлементОтбора.Имя] Тогда
					
					ЭлементОтбора.Значение = ЭтаФорма[КНС().ПрефиксИмениРеквизитаОтбора + ЭлементОтбора.Имя];
					ЭлементОтбора.Использование = Истина;
					
				Иначе
					
					ЭлементОтбора.Использование = Ложь;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОтборДинамическогоСписка(ОтборДС, УстановитьОтбор)
	
	ОтборДС.Элементы.Очистить();
	
	Если не УстановитьОтбор Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СтруктураРеквизитов = ПолучитьИзВременногоХранилища(АдресХранилищаСтруктураРеквизитов);
	
	РеквизитыОтбора = СтруктураРеквизитов.РеквизитыОтбора;
	РеквизитыОтбораИспользование = СтруктураРеквизитов.РеквизитыОтбораИспользование;
	
	Для каждого РеквизитОтбора из РеквизитыОтбора Цикл
		
		ПолеКомпоновки = Новый ПолеКомпоновкиДанных(РеквизитОтбора.Ключ);
		
		Если ОтборДС.ДоступныеПоляОтбора.НайтиПоле(ПолеКомпоновки) = Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли; 
		
		Если не ЭтаФорма[РеквизитыОтбораИспользование[РеквизитОтбора.Ключ]] Тогда
			
			Продолжить;
			
		КонецЕсли;		
		ЭлементОтбора = ОтборДС.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ЛевоеЗначение = ПолеКомпоновки;
		ЭлементОтбора.ПравоеЗначение = ЭтаФорма[РеквизитОтбора.Значение];
		ЭлементОтбора.Использование = Истина;
		
	КонецЦикла;
	
	ОтборКомпоновщика = КомпоновщикНастроек.Настройки.Отбор;
	
	СкопироватьЭлементыОтбора(ОтборДС.Элементы, ОтборКомпоновщика.Элементы);
			
КонецПроцедуры


&НаСервере
Процедура СкопироватьЭлементыОтбора(ПриемникЭлементы, ИсточникЭлементы)

	Для каждого ЭлементИсточник Из ИсточникЭлементы Цикл
		
		Если не ЭлементИсточник.Использование Тогда
			
			Продолжить;
			
		КонецЕсли;

        Если ТипЗнч(ЭлементИсточник) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
            // Создаем группу в приемнике
            ГруппаПриемник = ПриемникЭлементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
            ЗаполнитьЗначенияСвойств(ГруппаПриемник, ЭлементИсточник);
            // Рекурсивно копируем содержимое группы
            СкопироватьЭлементыОтбора(ГруппаПриемник.Элементы, ЭлементИсточник.Элементы);

        ИначеЕсли ТипЗнч(ЭлементИсточник) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
            // Создаем простой элемент
            ЭлементПриемник = ПриемникЭлементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
            ЗаполнитьЗначенияСвойств(ЭлементПриемник, ЭлементИсточник);

        КонецЕсли;

    КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруИспользуемыхЗначений(ДляСозданияЗаписи = Ложь)
// возможно следует переписать без перебора метаданных?	
	СтруктураИспользуемыхЗначений = Новый Структура;
	
	Для Каждого СтандартныйРеквизит из Метаданные.РегистрыСведений[ИмяРегистраСведений].СтандартныеРеквизиты Цикл
		
		Если СтандартныйРеквизит.Имя = "НомерСтроки" Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если не ДляСозданияЗаписи и не ЭтаФорма[КНС().ПрефиксИмениРеквизитаИспользование + СтандартныйРеквизит.Имя] Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		СтруктураИспользуемыхЗначений.Вставить(СтандартныйРеквизит.Имя, ЭтаФорма[КНС().ПрефиксИмениРеквизита + СтандартныйРеквизит.Имя]);
		
	КонецЦикла;
	
	Для Каждого Измерение из Метаданные.РегистрыСведений[ИмяРегистраСведений].Измерения Цикл
		
		Если ЭтаФорма[КНС().ПрефиксИмениРеквизитаИспользование + Измерение.Имя] Тогда
			
			СтруктураИспользуемыхЗначений.Вставить(Измерение.Имя, ЭтаФорма[КНС().ПрефиксИмениРеквизита + Измерение.Имя]);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Ресурс из Метаданные.РегистрыСведений[ИмяРегистраСведений].Ресурсы Цикл
		
		ЭтоХранилищеЗначения = Ресурс.Тип.СодержитТип(Тип("ХранилищеЗначения"));
		//ЭтоПолеУИД = Ресурс.Тип.СодержитТип(Тип("УникальныйИдентификатор"));
		
		Если ЭтоХранилищеЗначения Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если ЭтаФорма[КНС().ПрефиксИмениРеквизитаИспользование + Ресурс.Имя] Тогда
			//Если ЭтоПолеУИД Тогда 
			//	СтруктураИспользуемыхЗначений.Вставить(Ресурс.Имя, Новый УникальныйИдентификатор(ЭтаФорма["__РеквизитРС_"+Ресурс.Имя]));
			//Иначе
				СтруктураИспользуемыхЗначений.Вставить(Ресурс.Имя, ЭтаФорма[КНС().ПрефиксИмениРеквизита + Ресурс.Имя]);
			//КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Реквизит из Метаданные.РегистрыСведений[ИмяРегистраСведений].Реквизиты Цикл
		ЭтоХранилищеЗначения = Реквизит.Тип.СодержитТип(Тип("ХранилищеЗначения"));
		//ЭтоПолеУИД = Реквизит.Тип.СодержитТип(Тип("УникальныйИдентификатор"));
		
		Если ЭтоХранилищеЗначения Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если ЭтаФорма[КНС().ПрефиксИмениРеквизитаИспользование + Реквизит.Имя] Тогда
			//Если ЭтоПолеУИД Тогда 
			//	СтруктураИспользуемыхЗначений.Вставить(Реквизит.Имя, Новый УникальныйИдентификатор(ЭтаФорма["__РеквизитРС_"+Реквизит.Имя]));
			//Иначе
				СтруктураИспользуемыхЗначений.Вставить(Реквизит.Имя, ЭтаФорма[КНС().ПрефиксИмениРеквизита + Реквизит.Имя]);
			//КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтруктураИспользуемыхЗначений;
	
КонецФункции

&НаСервере
Процедура ДобавитьРеквизитФормыСвойство(ЭлементМетаданных, ЭлементГруппаСвойств)
	
	ЭтоХранилищеЗначения = ЭлементМетаданных.Тип.СодержитТип(Тип("ХранилищеЗначения"));
	ЭтоПолеПароля = ЭлементМетаданных.РежимПароля;
	//ЭтоПолеУИД = ЭлементМетаданных.Тип.СодержитТип(Тип("УникальныйИдентификатор"));
	ЭтоНомерСтроки = (ЭлементМетаданных.Имя = "НомерСтроки");
	
	МассивДобавляемыхРеквизитов = Новый Массив;
	
	//ИмяРеквизита = "__РеквизитРС_"+ЭлементМетаданных.Имя;
	ИмяРеквизита = КНС().ПрефиксИмениРеквизита + ЭлементМетаданных.Имя;
	ИмяЭлемента = КНС().ПрефиксИмениЭлемента + ЭлементМетаданных.Имя;
	ИмяЭлементаСписка = КНС().ПрефиксИмениЭлементаСписка + ЭлементМетаданных.Имя;
	ИмяГруппыЭлементов = КНС(). ПрефиксИмениГруппыЭлементов + ЭлементМетаданных.Имя;
	
	Если не (ЭтоХранилищеЗначения или ЭтоНомерСтроки)Тогда
		//Если не ЭтоПолеУИД Тогда
			МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(ИмяРеквизита, ЭлементМетаданных.Тип));
		//Иначе
		//	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(ИмяРеквизита, Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36))));
		//КонецЕсли;
	
		МассивРеквизитовРС.Добавить(ИмяРеквизита);
		
		ИмяРеквизитаИспользование = КНС().ПрефиксИмениРеквизитаИспользование + ЭлементМетаданных.Имя;
		ИмяЭлементаИспользование = "__ЭлементИспользование_"+ЭлементМетаданных.Имя;
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(ИмяРеквизитаИспользование, Новый ОписаниеТипов("Булево"),,"Использовать"));
		МассивРеквизитовРС.Добавить(ИмяРеквизитаИспользование);
			
		ЭтаФорма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов, );
		        	
		ГруппаЭлементов = ЭтаФорма.Элементы.Добавить(ИмяГруппыЭлементов, Тип("ГруппаФормы"), ЭлементГруппаСвойств);
		ГруппаЭлементов.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаЭлементов.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		ГруппаЭлементов.ОтображатьЗаголовок = Ложь;
		МассивЭлементовФормыРС.Добавить(ИмяГруппыЭлементов);
		
		НовыйЭлементФормы = ЭтаФорма.Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"),ГруппаЭлементов);
		НовыйЭлементФормы.ПутьКДанным = ИмяРеквизита;
		НовыйЭлементФормы.Заголовок = ЭлементМетаданных.Имя;
		
		Если ЭлементМетаданных.Тип = Новый ОписаниеТипов("УникальныйИдентификатор") Тогда
			
			НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеНадписи;
			НовыйЭлементФормы.Гиперссылка = Истина;
			НовыйЭлементФормы.УстановитьДействие("Нажатие","РеквизитУИДНажатие");	
			
		Иначе
			
			НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеВвода;
			НовыйЭлементФормы.УстановитьДействие("ПриИзменении","РеквизитПриИзменении");				
			
		КонецЕсли;
		
	 	НовыйЭлементФормы = ЭтаФорма.Элементы.Добавить(ИмяЭлементаИспользование, Тип("ПолеФормы"), ГруппаЭлементов);
		НовыйЭлементФормы.ПутьКДанным = ИмяРеквизитаИспользование;
		НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеФлажка;
		
		СтруктураРеквизитов.РеквизитыВПоляхВводаИспользование.Вставить(ЭлементМетаданных.Имя, ИмяРеквизитаИспользование);
		СтруктураРеквизитов.РеквизитыВПоляхВвода.Вставить(ЭлементМетаданных.Имя, ИмяРеквизита);
		СтруктураРеквизитов.ЭлементыПоляВвода.Вставить(ИмяЭлемента, ИмяРеквизита);

	КонецЕсли;

	Если не (ЭтоХранилищеЗначения или ЭтоПолеПароля) Тогда
		
		СтруктураРеквизитов.РеквизитыВСписке.Вставить(ЭлементМетаданных.Имя, ИмяРеквизита);
		
		НовыйЭлементФормы = ЭтаФорма.Элементы.Добавить(ИмяЭлементаСписка, Тип("ПолеФормы"), Элементы[КНС().ИмяЭлементаСписокЗаписейРС]);
		НовыйЭлементФормы.ПутьКДанным = КНС().ИмяРеквизитаСписокЗаписейРС + "."+ЭлементМетаданных.Имя;
		МассивЭлементовФормыРС.Добавить(ИмяЭлементаСписка);
		
	КонецЕсли;
	
	Если ЭтоХранилищеЗначения Тогда
		
		СтруктураРеквизитов.РеквизитыХранилищаЗначения.Добавить(ЭлементМетаданных.Имя);
		
	КонецЕсли;
	
	Если ЭтоПолеПароля Тогда
		
		СтруктураРеквизитов.РеквизитыПароли.Вставить(ЭлементМетаданных.Имя,ИмяРеквизита);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьРеквизитФормыОтборНабораЗаписей(ЭлементОтбора)
	
	ЭлементГруппаСвойств = Элементы["ГруппаОтборНабораЗаписей"];

	МассивДобавляемыхРеквизитов = Новый Массив;
	
	ИмяЭлементаОтбора = ЭлементОтбора.Имя;
	
	ИмяРеквизита = КНС().ПрефиксИмениРеквизитаОтбора + ИмяЭлементаОтбора;
	ИмяЭлемента = КНС().ПрефиксИмениЭлементаОтбора + ИмяЭлементаОтбора;
	ИмяРеквизитаИспользование = КНС().ПрефиксИмениРеквизитаОтбораИспользование + ИмяЭлементаОтбора;
	ИмяЭлементаИспользование = "__ЭлементОтбораИспользование_"+ИмяЭлементаОтбора;
	ИмяГруппыЭлементов = "__ГруппаОтбора_"+ИмяЭлементаОтбора;
	
	// добваление реквизитов
	
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(ИмяРеквизита, ЭлементОтбора.ТипЗначения));
	МассивРеквизитовРС.Добавить(ИмяРеквизита);
	СтруктураРеквизитов.РеквизитыОтбора.Вставить(ИмяЭлементаОтбора, ИмяРеквизита);
	СтруктураРеквизитов.РеквизитыОтбораИспользование.Вставить(ИмяЭлементаОтбора, ИмяРеквизитаИспользование);
	СтруктураРеквизитов.ЭлементыОтбора.Вставить(ИмяЭлемента, ИмяРеквизита);
	
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(ИмяРеквизитаИспользование, Новый ОписаниеТипов("Булево"),,"Использовать"));
	МассивРеквизитовРС.Добавить(ИмяРеквизитаИспользование);
		
	ЭтаФорма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов, );
	
	// добавление элементов 
	
	ГруппаЭлементов = ЭтаФорма.Элементы.Добавить(ИмяГруппыЭлементов, Тип("ГруппаФормы"), ЭлементГруппаСвойств);
	ГруппаЭлементов.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаЭлементов.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	ГруппаЭлементов.ОтображатьЗаголовок = Ложь;
	МассивЭлементовФормыРС.Добавить(ИмяГруппыЭлементов);
	
	НовыйЭлементФормы = ЭтаФорма.Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"),ГруппаЭлементов);
	НовыйЭлементФормы.ПутьКДанным = ИмяРеквизита;
	НовыйЭлементФормы.Заголовок = ИмяЭлементаОтбора;
	
	Если ЭлементОтбора.ТипЗначения = Новый ОписаниеТипов("УникальныйИдентификатор") Тогда

		НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеНадписи;
		НовыйЭлементФормы.Гиперссылка = Истина;
		НовыйЭлементФормы.УстановитьДействие("Нажатие","РеквизитОтбораНабораЗаписейУИДНажатие");	

	Иначе
		
		НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлементФормы.УстановитьДействие("ПриИзменении","РеквизитОтбораНабораЗаписейПриИзменении");	
		
	КонецЕсли;
	
	НовыйЭлементФормы = ЭтаФорма.Элементы.Добавить(ИмяЭлементаИспользование, Тип("ПолеФормы"), ГруппаЭлементов);
	НовыйЭлементФормы.ПутьКДанным = ИмяРеквизитаИспользование;
	НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеФлажка;
	
	//Если ИмяЭлементаОтбора = "Регистратор" Тогда
	//	
	//	ЭтаФорма[ИмяРеквизитаИспользование] = Истина;
	//	Элементы[ИмяЭлементаИспользование].Доступность = ложь;
	//	
	//КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура РеквизитПриИзмененииНаСервере(ИмяЭлемента)
	
	ПутьКДанным = ЭтаФорма.Элементы[ИмяЭлемента].ПутьКДанным;
	
	Если ЗначениеЗаполнено(ЭтаФорма[ПутьКДанным]) Тогда
		
		СтруктураРеквизитов = ПолучитьИзВременногоХранилища(АдресХранилищаСтруктураРеквизитов);
		
		Для каждого ЭлементСтруктуры из СтруктураРеквизитов.РеквизитыВПоляхВвода Цикл
			
			Если ЭлементСтруктуры.Значение = ПутьКДанным Тогда
				
				ИмяМетаданных = ЭлементСтруктуры.Ключ;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ЭтаФорма[СтруктураРеквизитов.РеквизитыВПоляхВводаИспользование[ИмяМетаданных]] = Истина;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементов()
	
	Элементы.ГруппаЭлементыРеквизитыРС.Видимость = ЗначениеЗаполнено(ИмяРегистраСведений);

КонецПроцедуры

&НаСервере
Процедура ИницализироватьРеквизитыЭлементыФормы()
	
	ЭтаФорма[КНС().ИмяРеквизитаСписокЗаписейРС].ОсновнаяТаблица = "РегистрСведений."+ИмяРегистраСведений;
	
	ЭтаФорма[КНС().ИмяРеквизитаСписокЗаписейРС].ДинамическоеСчитываниеДанных = Истина;
	
	ЭтаФорма[КНС().ИмяРеквизитаСписокЗаписейРС].Отбор.Элементы.Очистить();
	ЭтаФорма[КНС().ИмяРеквизитаСписокЗаписейРС].Группировка.Элементы.Очистить();

	// удаление старых реквизитов и элементов
	МассивЭлементовФормыРС = ПолучитьИзВременногоХранилища(АдресХранилищаЭлементовРеквизитовФормы);
	
	Для Каждого ЭлементФормы из МассивЭлементовФормыРС Цикл
		
		ЭтаФорма.Элементы.Удалить(ЭтаФорма.Элементы[ЭлементФормы]);
		
	КонецЦикла;	
	
	МассивРеквизитовРС = ПолучитьИзВременногоХранилища(АдресХранилищаРеквизитовФормы);
	ЭтаФорма.ИзменитьРеквизиты(, МассивРеквизитовРС);	

	// создание новых реквизитов и элементов
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("РеквизитыВСписке", Новый Структура);
	СтруктураРеквизитов.Вставить("РеквизитыВПоляхВвода", Новый Структура);
	СтруктураРеквизитов.Вставить("ЭлементыПоляВвода", Новый Структура);
	СтруктураРеквизитов.Вставить("РеквизитыВПоляхВводаИспользование", Новый Структура);
	СтруктураРеквизитов.Вставить("РеквизитыОтбора", Новый Структура);
	СтруктураРеквизитов.Вставить("РеквизитыОтбораИспользование", Новый Структура);
	СтруктураРеквизитов.Вставить("ЭлементыОтбора", Новый Структура);
	СтруктураРеквизитов.Вставить("РеквизитыХранилищаЗначения", Новый Массив);
	СтруктураРеквизитов.Вставить("РеквизитыПароли", Новый Структура);
	СтруктураРеквизитов.Вставить("КлючевыеПоляВнеОтбора", Новый Массив);
	СтруктураРеквизитов.Вставить("ИменаКлючевыхПолей", Новый Массив);
	
	МассивРеквизитовРС = Новый Массив;
	МассивДобавляемыхРеквизитов = Новый Массив;
	МассивЭлементовФормыРС = Новый Массив;
	
	Периодический = не (Метаданные.РегистрыСведений[ИмяРегистраСведений].ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический);
	ПодчинениеРегистратору = (Метаданные.РегистрыСведений[ИмяРегистраСведений].РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору);
	ПоПозицииРегистратора = (Метаданные.РегистрыСведений[ИмяРегистраСведений].ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.ПозицияРегистратора);
	
	Элементы.ДекорацияПериодичность.Заголовок = "Периодичность: " + Строка(Метаданные.РегистрыСведений[ИмяРегистраСведений].ПериодичностьРегистраСведений);
	Элементы.ДекорацияРежимЗаписи.Заголовок = "Режим записи: " + Метаданные.РегистрыСведений[ИмяРегистраСведений].РежимЗаписи;
	
	НаборЗаписей = РегистрыСведений[ИмяРегистраСведений].СоздатьНаборЗаписей();
	
	Для Каждого ЭлементОтбора из НаборЗаписей.Отбор Цикл
		
		ДобавитьРеквизитФормыОтборНабораЗаписей(ЭлементОтбора);
		
	КонецЦикла;
	
	Для Каждого СтандартныйРеквизит из Метаданные.РегистрыСведений[ИмяРегистраСведений].СтандартныеРеквизиты Цикл
		
		Если (СтандартныйРеквизит.Имя = "Период")  и не СтруктураРеквизитов.РеквизитыОтбора.Свойство("Период") Тогда
			
			СтруктураРеквизитов.КлючевыеПоляВнеОтбора.Добавить(СтандартныйРеквизит.Имя);
			
		КонецЕсли;
		
		Если СтандартныйРеквизит.Имя = "Период" или СтандартныйРеквизит.Имя = "Регистратор" Тогда
			
			СтруктураРеквизитов.ИменаКлючевыхПолей.Добавить(СтандартныйРеквизит.Имя);
			
		КонецЕсли;
		
		ДобавитьРеквизитФормыСвойство(СтандартныйРеквизит, Элементы["ГруппаСтандартныеРеквизиты"]);
		
	КонецЦикла;
	
	Для Каждого Измерение из Метаданные.РегистрыСведений[ИмяРегистраСведений].Измерения Цикл
		
		Если Не ДостпноИспользованиеРеквизита(Измерение) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если не СтруктураРеквизитов.РеквизитыОтбора.Свойство(Измерение.Имя) Тогда
			
			СтруктураРеквизитов.КлючевыеПоляВнеОтбора.Добавить(Измерение.Имя);
			
		КонецЕсли;
		
		СтруктураРеквизитов.ИменаКлючевыхПолей.Добавить(Измерение.Имя);
	
		ДобавитьРеквизитФормыСвойство(Измерение, Элементы["ГруппаИзмерения"]);
		
	КонецЦикла;
	
	Для Каждого Ресурс из Метаданные.РегистрыСведений[ИмяРегистраСведений].Ресурсы Цикл
		
		Если Не ДостпноИспользованиеРеквизита(Ресурс) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ДобавитьРеквизитФормыСвойство(Ресурс, Элементы["ГруппаРесурсы"]);
		
	КонецЦикла;
	
	Для Каждого Реквизит из Метаданные.РегистрыСведений[ИмяРегистраСведений].Реквизиты Цикл
		
		Если Не ДостпноИспользованиеРеквизита(Реквизит) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ДобавитьРеквизитФормыСвойство(Реквизит, Элементы["ГруппаРеквизиты"]);
		
	КонецЦикла;

	Если (СтруктураРеквизитов.РеквизитыПароли.Количество() <> 0) или (СтруктураРеквизитов.РеквизитыХранилищаЗначения.Количество() <> 0) Тогда
		
		ЕстьСпецРеквизиты = Истина;
		
		ДобавляемыеРеквизиты = Новый Массив;
		
		НовыйРеквизит = Новый РеквизитФормы(КНС().ИмяРеквизитаТаблицаСпецРеквизитовРС, Новый ОписаниеТипов("ТаблицаЗначений"));
		ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
		НовыйРеквизит = Новый РеквизитФормы("__КлючЗаписи", Новый ОписаниеТипов(),КНС().ИмяРеквизитаТаблицаСпецРеквизитовРС);
		ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
		

		ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		
		МассивРеквизитовРС.Добавить(КНС().ИмяРеквизитаТаблицаСпецРеквизитовРС);
		
		ЭлементТаблицаСпецРеквизитовРС = ЭтаФорма.Элементы.Вставить(КНС().ИмяЭлементаТаблицаСпецРеквизитовРС, Тип("ТаблицаФормы"),ЭтаФорма.Элементы["ГруппаСписки"]);
		ЭлементТаблицаСпецРеквизитовРС.ПутьКДанным = КНС().ИмяРеквизитаТаблицаСпецРеквизитовРС;
		ЭлементТаблицаСпецРеквизитовРС.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Авто;
		ЭлементТаблицаСпецРеквизитовРС.Заголовок = "Специальные реквизиты (хранилища значения, пароли)";
		ЭлементТаблицаСпецРеквизитовРС.МножественныйВыбор = Ложь;
		ЭлементТаблицаСпецРеквизитовРС.ИзменятьСоставСтрок = Ложь;
		ЭлементТаблицаСпецРеквизитовРС.ИзменятьПорядокСтрок = Ложь;
		ЭлементТаблицаСпецРеквизитовРС.ТолькоПросмотр = Истина;
		ЭлементТаблицаСпецРеквизитовРС.ВариантУправленияВысотой = ВариантУправленияВысотойТаблицы.ВСтрокахТаблицы;
		ЭлементТаблицаСпецРеквизитовРС.ВысотаВСтрокахТаблицы = 1;
		ЭлементТаблицаСпецРеквизитовРС.РастягиватьПоВертикали = Ложь;
		ЭлементТаблицаСпецРеквизитовРС.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
		
		ЭлементТаблицаСпецРеквизитовРС.УстановитьДействие("Выбор", "ТаблицаСпецРеквизитовРСВыбор");
		
		МассивЭлементовФормыРС.Добавить(КНС().ИмяЭлементаТаблицаСпецРеквизитовРС);
		
		ЭлементМеню = Элементы.Добавить("КомандаПрочитатьСпецРеквизиты",Тип("КнопкаФормы"), Элементы[КНС().ИмяЭлементаСписокЗаписейРС].КонтекстноеМеню);
		ЭлементМеню.ИмяКоманды = "ПрочитатьСпецРеквизиты";
		МассивЭлементовФормыРС.Добавить("КомандаПрочитатьСпецРеквизиты");

		
		Для Каждого РеквзитХранилище Из СтруктураРеквизитов.РеквизитыХранилищаЗначения Цикл
			
			ДобавляемыеРеквизиты.Очистить();
			
			НовыйРеквизит = Новый РеквизитФормы(РеквзитХранилище, Новый ОписаниеТипов("Строка"), КНС().ИмяРеквизитаТаблицаСпецРеквизитовРС, РеквзитХранилище);
			ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
			ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
			
			НовыйЭлементКолонка = Элементы.Добавить(РеквзитХранилище, Тип("ПолеФормы"), ЭлементТаблицаСпецРеквизитовРС);
			НовыйЭлементКолонка.ПутьКДанным = КНС().ИмяРеквизитаТаблицаСпецРеквизитовРС + "." + РеквзитХранилище;
			НовыйЭлементКолонка.Вид = ВидПоляФормы.ПолеВвода;
			
		КонецЦикла;
		
		Для Каждого РеквзитПароль Из СтруктураРеквизитов.РеквизитыПароли Цикл
			
			ДобавляемыеРеквизиты.Очистить();
			
			НовыйРеквизит = Новый РеквизитФормы(РеквзитПароль.Ключ, Новый ОписаниеТипов("Строка"), КНС().ИмяРеквизитаТаблицаСпецРеквизитовРС, РеквзитПароль.Ключ);
			ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
			ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
			
			НовыйЭлементКолонка = Элементы.Добавить(РеквзитПароль.Ключ, Тип("ПолеФормы"), ЭлементТаблицаСпецРеквизитовРС);
			НовыйЭлементКолонка.ПутьКДанным = КНС().ИмяРеквизитаТаблицаСпецРеквизитовРС + "." + РеквзитПароль.Ключ;
			
			НовыйЭлементКолонка.Вид = ВидПоляФормы.ПолеВвода;
			
		КонецЦикла;
		
	Иначе
		
		ЕстьСпецРеквизиты = Ложь;
		
	КонецЕсли;
	
	АдресХранилищаРеквизитовФормы = ПоместитьВоВременноеХранилище(МассивРеквизитовРС, ЭтаФорма.УникальныйИдентификатор);
	АдресХранилищаЭлементовРеквизитовФормы = ПоместитьВоВременноеХранилище(МассивЭлементовФормыРС, ЭтаФорма.УникальныйИдентификатор);
	АдресХранилищаСтруктураРеквизитов = ПоместитьВоВременноеХранилище(СтруктураРеквизитов, ЭтаФорма.УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьСКД()
	
	НЗ = РегистрыСведений[ИмяРегистраСведений].СоздатьНаборЗаписей();
	
	ТаблицаНЗ = НЗ.Выгрузить();
	
	СКД = Новый СхемаКомпоновкиДанных;
	
	ИсточникДанных = СКД.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "local";
	
	НаборДанных = СКД.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя = "НаборДанных1";
	НаборДанных.ИмяОбъекта = "ТЗ";
	НаборДанных.ИсточникДанных = "ИсточникДанных1";
	
	НастройкиСКД = СКД.НастройкиПоУмолчанию;
	
	Для Каждого Колонка из ТаблицаНЗ.Колонки Цикл
		
		ПолеНабораданных = НаборДанных.Поля.Добавить(тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		ПолеНабораданных.ПутьКДанным = Колонка.Имя;
		ПолеНабораданных.ТипЗначения = Колонка.ТипЗначения;
		ПолеНабораданных.Поле = Колонка.Имя;
		ПолеНабораданных.Заголовок = Колонка.Имя;
		
		ВыбранноеПоле = НастройкиСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(Колонка.Имя);
		ВыбранноеПоле.Использование = Истина;
		
	КонецЦикла;
	
	ПолеНабораданных = НаборДанных.Поля.Добавить(тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
	ПолеНабораданных.ПутьКДанным = "__УИД_Строки";
	ПолеНабораданных.ТипЗначения = Новый ОписаниеТипов("УникальныйИдентификатор");
	ПолеНабораданных.Поле = "__УИД_Строки";
	ПолеНабораданных.Заголовок = "УИД строки";
	ПолеНабораданных.ОграничениеИспользования.Условие = Истина;
	
	ДетальныеЗаписи = НастройкиСКД.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ДетальныеЗаписи.Имя = "ДетальныеЗаписи";
	ДетальныеЗаписи.Использование = Истина;
	АвтоПоле = ДетальныеЗаписи.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	АвтоПоле.Использование = Истина;
	
	СтруктураРеквизитов = ПолучитьИзВременногоХранилища(АдресХранилищаСтруктураРеквизитов);
	
	Для каждого КлючевоеПоле Из СтруктураРеквизитов.КлючевыеПоляВнеОтбора Цикл
		
		ОтборСКД = НастройкиСКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));	
		ОтборСКД.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(КлючевоеПоле);
		ОтборСКД.Использование = Ложь;
		
	КонецЦикла;
	
	АдресХранилищаСКД = ПоместитьВоВременноеХранилище(СКД, ЭтаФорма);
	
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресХранилищаСКД));
	КомпоновщикНастроек.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию);
		
КонецПроцедуры

&НаСервере
Функция ЕстьОтборСКД()
	
	Результат = Ложь;
	
	Для Каждого ЭлементОтбора из КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
		
		Если ЭлементОтбора.Использование Тогда
			
			Результат = Истина;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПолучитьТЗПоОтбору(Знач ТЗ, ДляИзменения = Ложь)
	
		СКД = ПолучитьИзВременногоХранилища(АдресХранилищаСКД);
		
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		Настройки = КомпоновщикНастроек.ПолучитьНастройки();
		
		Если ДляИзменения Тогда
			
			ВыбранноеПоле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("__УИД_Строки");
			ВыбранноеПоле.Использование = Истина;			
			
		КонецЕсли;
		
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		ВнешнийНаборДанных = Новый Структура;
		ВнешнийНаборДанных.Вставить("ТЗ",ТЗ); 
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки,ВнешнийНаборДанных);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		ТабРезультат = Новый ТаблицаЗначений;
		ПроцессорВывода.УстановитьОбъект(ТабРезультат);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);

	    Возврат ТабРезультат;
		
КонецФункции

&НаСервере
Процедура ДобавитьКолонкуУИДСтроки(ТЗ)
	
	ТЗ.Колонки.Добавить("__УИД_строки", Новый ОписаниеТипов("УникальныйИдентификатор"));
	
	Для Каждого СтрТаб из ТЗ Цикл
		
		СтрТаб.__УИД_строки = Новый УникальныйИдентификатор;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиИзТаблицыПоУИД(ТЗДляУдаления, ТЗУдаляемыеСтроки)
	
	Для Каждого СтрТаб из ТЗУдаляемыеСтроки Цикл
	
		УдаляемаяСтрока = ТЗДляУдаления.Найти(СтрТаб.__УИД_строки, "__УИД_строки");
		
		Если не УдаляемаяСтрока = Неопределено Тогда
			
			ТЗДляУдаления.Удалить(УдаляемаяСтрока);
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРедакторКода(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗакрытиеРедактораКода",ЭтаФорма);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПроизвольныйАлгоритм", ПроизвольныйАлгоритм);
	ПараметрыФормы.Вставить("Режим", "ЗаписьРС");
	ОткрытьФорму("ВнешняяОбработка.РедактроРегистровСведений.Форма.ФормаРедакторКода",ПараметрыФормы ,ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытиеРедактораКода(РезультатЗакрытия,ДопПараметры) Экспорт
	
	ПроизвольныйАлгоритм = РезультатЗакрытия.ПроизвольныйАлгоритм;

КонецПроцедуры

&НаСервере
Функция ДостпноИспользованиеРеквизита(Знач МетаданныеРеквизит)
	
	ВходитВСоставФО = Ложь;
	
	Для Каждого ФО из Метаданные.ФункциональныеОпции Цикл
		
		Если ФО.Состав.Содержит(МетаданныеРеквизит) Тогда
			
			ВходитВСоставФО = Истина;
			
			Если ПолучитьФункциональнуюОпцию(ФО.Имя) Тогда
				
				Возврат Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если не ВходитВСоставФО Тогда
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ЗаписатьЗначениеВXML(Значение, ЗаписьXML)
	
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("_1CV8DtUD", "http://www.1c.ru/V8/1CV8DtUD/");
	
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("V8Exch", "http://www.1c.ru/V8/1CV8DtUD/");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("core", "http://v8.1c.ru/data");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("v8", "http://v8.1c.ru/8.1/data/enterprise/current-config");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xs", "http://www.w3.org/2001/XMLSchema");
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("V8Exch:Data");
	
	Сериализатор = СериализаторXDTO;
	
	Попытка 
		
		Сериализатор.ЗаписатьXML(ЗаписьXML, Значение);
		
	Исключение
		
		Сообщить(ОписаниеОшибки(), СтатусСообщения.Важное);
		Возврат Ложь;
		
	КонецПопытки;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); //V8Exc:Data
	ЗаписьXML.ЗаписатьКонецЭлемента(); //V8Exc:_1CV8DtUD
	ЗаписьXML.Закрыть();
	
	Возврат Истина;

КонецФункции

&НаСервере
Функция ВыгрузитьВXMLНаСервере(ПоОтбору = Ложь)
	
	НаборЗаписей = РегистрыСведений[ИмяРегистраСведений].СоздатьНаборЗаписей();
	
	КоличествоЗаписей = 0;
	
	Если ПоОтбору Тогда
		
		ЗаполнитьОтборНабораЗаписей(НаборЗаписей, "ПоПолямОтбора");
		
		НаборЗаписей.Прочитать();
		
		Если ЕстьОтборСКД() Тогда
			
			ТЗНабора = НаборЗаписей.Выгрузить();
			
			ДобавитьКолонкуУИДСтроки(ТЗНабора);
			
			ТЗПоОтбору = ПолучитьТЗПоОтбору(ТЗНабора, Истина);
			
			НаборЗаписей.Очистить();
			НаборЗаписей.Загрузить(ТЗПоОтбору);
			
		КонецЕсли;
		
		ДанныеДляЗаписи = НаборЗаписей;
		КоличествоЗаписей = НаборЗаписей.Количество();
		
	Иначе
		
		Если ПодчинениеРегистратору Тогда
			
			ВсеРегистраторы = ПолучитьМассивВсехРегистраторов();
			МассивНЗ = Новый Массив;
			КоличествоЗаписей = 0;
			
			Для каждого Регистратор Из ВсеРегистраторы Цикл
				
				НаборЗаписей = РегистрыСведений[ИмяРегистраСведений].СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Регистратор.Значение = Регистратор;
				НаборЗаписей.Прочитать();
				МассивНЗ.Добавить(НаборЗаписей);
				КоличествоЗаписей = КоличествоЗаписей + НаборЗаписей.Количество();
				
			КонецЦикла;
			
			ДанныеДляЗаписи = МассивНЗ;
			
		Иначе
			
			НаборЗаписей.Прочитать();
			ДанныеДляЗаписи = НаборЗаписей;
			КоличествоЗаписей = НаборЗаписей.Количество();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если КоличествоЗаписей = 0 Тогда

		Сообщить("Нет данных для выгрузки.", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка 
	
		Путь = КаталогВременныхФайлов();
		ИмяВременногоФайла = Путь + Строка(Новый УникальныйИдентификатор) + ".xml";
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.ОткрытьФайл(ИмяВременногоФайла, "UTF-8");
		
		Если ЗаписатьЗначениеВXML(ДанныеДляЗаписи, ЗаписьXML) Тогда
			
			ДД = Новый ДвоичныеДанные(ИмяВременногоФайла);
			АдресХранилища = ПоместитьВоВременноеХранилище(ДД);
			
		КонецЕсли;
		
		УдалитьФайлы(Путь, ИмяВременногоФайла);

		Возврат Новый Структура("АдресХранилища, КоличествоЗаписей", АдресХранилища, КоличествоЗаписей);
		
	Исключение
		
		Сообщить(ОписаниеОшибки());
		Возврат Неопределено;
		
	КонецПопытки;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьИзXMLНаСервере(АдресВХранилище)
	
	Путь = КаталогВременныхФайлов();
	ИмяВременногоФайла = Путь + Строка(Новый УникальныйИдентификатор)+".xml";
	ДД = ПолучитьИзВременногоХранилища(АдресВХранилище);
	ДД.Записать(ИмяВременногоФайла);
	
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяВременногоФайла);
	// проверка формата файла обмена
	Если Не ЧтениеXML.Прочитать()
		Или ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента
		Или ЧтениеXML.ЛокальноеИмя <> "_1CV8DtUD"
		Или ЧтениеXML.URIПространстваИмен <> "http://www.1c.ru/V8/1CV8DtUD/" Тогда
		
		Сообщить("Неверный формат файла выгрузки", СтатусСообщения.Важное);
		Возврат;
		
	КонецЕсли;
	
	Если Не ЧтениеXML.Прочитать()
		Или ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента
		Или ЧтениеXML.ЛокальноеИмя <> "Data" Тогда
		
		Сообщить("Неверный формат файла выгрузки", СтатусСообщения.Важное);
		Возврат;
		
	КонецЕсли;
	
	Если Не ЧтениеXML.Прочитать() Тогда 
		
		Сообщить("Неверный формат файла выгрузки", СтатусСообщения.Важное);
		Возврат;
		
	КонецЕсли;
	
	Сериализатор = СериализаторXDTO;
	
		
	ДанныеДляЗагрузки = Сериализатор.ПрочитатьXML(ЧтениеXML);
	
	Если ТипЗнч(ДанныеДляЗагрузки) = Тип("Массив") Тогда
		
		ДанныеДляПроверкиТипа = ДанныеДляЗагрузки[0];
		
	Иначе
		
		ДанныеДляПроверкиТипа = ДанныеДляЗагрузки;
		
	КонецЕсли;
	
	Если не ТипЗнч(ДанныеДляПроверкиТипа) = Тип("РегистрСведенийНаборЗаписей."+ИмяРегистраСведений) Тогда
		
		Сообщить("Тип загружаемых данных в файле не соответствует набору записей РС. Загрузка не выполнена.",СтатусСообщения.Внимание);
		ЧтениеXML.Закрыть();
		Возврат;
		
	КонецЕсли;
		
	Если ТипЗнч(ДанныеДляЗагрузки) = Тип("Массив") Тогда
		
		Попытка
			
			НачатьТранзакцию();
			
			Для каждого НаборЗаписей Из ДанныеДляЗагрузки Цикл
				
				НаборЗаписей.ОбменДанными.Загрузка = ОбменДаннымиЗагрузка;
				НаборЗаписей.Записать();
				
			КонецЦикла;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			Сообщить(ОписаниеОшибки());
			
		КонецПопытки;

	Иначе
		
		Попытка
			
			НаборЗаписей = ДанныеДляЗагрузки;
			НаборЗаписей.ОбменДанными.Загрузка = ОбменДаннымиЗагрузка;
			НаборЗаписей.Записать();
			
		Исключение
			
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
		
	КонецЕсли;
	
	Сообщить("Загрузка из XML завершена.",СтатусСообщения.Внимание);
			
	ЧтениеXML.Закрыть();
	УдалитьФайлы(Путь, ИмяВременногоФайла);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДиалогXML(ОписаниеОповещения, РежимДиалога)
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалога);
	
	Если РежимДиалога = РежимДиалогаВыбораФайла.Сохранение Тогда
		
		ДиалогВыбораФайла.ПолноеИмяФайла = ИмяРегистраСведений;
		
	КонецЕсли;
	
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;
	ДиалогВыбораФайла.Фильтр = "Файл XML (*.xml)|*.xml";
	
	ДиалогВыбораФайла.Показать(ОписаниеОповещения);

КонецПроцедуры

&НаСервере
Процедура ПрочитатьЗначенияСпецРеквизитовВСтроку(СтрокаТаблицы, КлючЗаписи)
	
	СтруктураРеквизитов = ПолучитьИзВременногоХранилища(АдресХранилищаСтруктураРеквизитов);	
	
	РеквизитыПароли = СтруктураРеквизитов.РеквизитыПароли;
	РеквизитыХранилищаЗначения = СтруктураРеквизитов.РеквизитыХранилищаЗначения;
	
	
	СтрокаТаблицы.__КлючЗаписи = КлючЗаписи;
	
	Если ПодчинениеРегистратору Тогда 
		//СтрокаТаблицы.__Регистратор = Регистратор;
		
		НЗ = РегистрыСведений[ИмяРегистраСведений].СоздатьНаборЗаписей();
		НЗ.Отбор.Регистратор.Значение = КлючЗаписи.Регистратор;
		НЗ.Прочитать();
		ТабНЗ = НЗ.Выгрузить();
		
		НайденныеСтроки = ТабНЗ.НайтиСтроки(КлючЗаписи);
		
		Если не НайденныеСтроки = Неопределено Тогда
			
			Если НайденныеСтроки.Количество() = 1 Тогда
				
				НайденнаяСтрока = НайденныеСтроки[0];
				
				Для каждого РеквизитПароль Из РеквизитыПароли Цикл
					
					ЗаполнитьЗначенияСвойств(СтрокаТаблицы, НайденнаяСтрока, РеквизитПароль.Ключ);
					
				КонецЦикла;
				
				Для каждого РеквизитХранилище Из РеквизитыХранилищаЗначения Цикл
					
					ИндексКолонки = ТабНЗ.Колонки.Индекс(ТабНЗ.Колонки.Найти(РеквизитХранилище));
					ТипЗначениеВХранилище = Строка(ТипЗнч(НайденнаяСтрока[ИндексКолонки].Получить()));
					СтруктураЗаполнения = Новый ФиксированнаяСтруктура(РеквизитХранилище, ТипЗначениеВХранилище);
					ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтруктураЗаполнения);
					
				КонецЦикла;
				
			КонецЕсли;
				
		КонецЕсли;
		
	Иначе
		
		МЗ = РегистрыСведений[ИмяРегистраСведений].СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ, КлючЗаписи);
		МЗ.Прочитать();
		
		Для каждого РеквизитПароль Из РеквизитыПароли Цикл
			
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, МЗ, РеквизитПароль.Ключ);
			
		КонецЦикла;
		
		Для каждого РеквизитХранилище Из РеквизитыХранилищаЗначения Цикл
			
			ТипЗначениеВХранилище = Строка(ТипЗнч(МЗ[РеквизитХранилище].Получить()));
			СтруктураЗаполнения = Новый ФиксированнаяСтруктура(РеквизитХранилище, ТипЗначениеВХранилище);
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтруктураЗаполнения);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивВсехРегистраторов()
	
	Запрос = Новый Запрос;
	
	ТекстЗапроса  = "Выбрать различные
	|РС.Регистратор 
	|Из РегистрСведений.%ИМЯРС% как РС";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ИМЯРС%", ИмяРегистраСведений);
	
	Запрос.Текст = ТекстЗапроса;
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор");
	
КонецФункции

&НаКлиенте
Процедура СоздатьУИД(Команда)
	
	Сообщить(Новый УникальныйИдентификатор);

КонецПроцедуры



