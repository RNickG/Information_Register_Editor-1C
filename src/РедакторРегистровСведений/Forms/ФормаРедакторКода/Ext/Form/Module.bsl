
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Алгоритм = Параметры.ПроизвольныйАлгоритм;
	
	Если Параметры.Режим = "ЗаписьРС" Тогда
		
		Элементы.ИнструкцияОбработка.Видимость = Истина;
		ПримерИпользования = "Запись. = ";
		
	КонецЕсли;
	
	Если Параметры.Режим = "ХранилищеЗначения" Тогда
		
		Элементы.ИнструкцияХранилище.Видимость = Истина;
		ПримерИпользования = "Значение = ";
		
	КонецЕсли;
	
	Если СокрЛП(Алгоритм) = "" Тогда
		
		Алгоритм = ПримерИпользования;
		
	КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ПараметрыЗакрытия = Новый Структура;
	ПараметрыЗакрытия.Вставить("ПроизвольныйАлгоритм", Алгоритм);
	Закрыть(ПараметрыЗакрытия);

КонецПроцедуры




